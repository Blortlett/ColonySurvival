extends Node2D
## Cached drawing under DynamicLayer: zone overlays, roads, floors, walls, doors and
## furniture. Redrawn only when pieces or zones change (at most every REDRAW_SECS, so
## per-second decay shading stays cheap at 16x), plus a slow refresh for changes nobody
## flags (blueprint states, colours). Fires, glow, raids, bushes and loot stay per frame.

## Wall autotiles per tier (wood, reinforced, stone): 4x4 sheets of 32 px tiles,
## index = neighbour mask (N=1, E=2, S=4, W=8). Generated by tools/tilekit/wood_walls.py.
const WALL_SHEETS: Array[Texture2D] = [
	preload("res://art/structures/wood_walls.png"),
	preload("res://art/structures/reinforced_walls.png"),
	preload("res://art/structures/stone_walls.png"),
]
## Roads per tier (1 stone, 2 paved): strips of ROAD_VARIANTS 32 px tiles, picked per cell
## (tools/tilekit/roads.py). Edges that meet anything but road get ROAD_EDGE shading.
const ROAD_TEX: Array[Texture2D] = [
	preload("res://art/structures/road_stone.png"),
	preload("res://art/structures/road_paved.png"),
]
const ROAD_VARIANTS := 4
## Anvil on its stump, 32 px top-down (tools/tilekit/anvil.py).
const ANVIL_TEX := preload("res://art/structures/anvil.png")
## Basic chest, storage crate and sawmill, 32 px top-down (tools/tilekit/furniture.py).
## The sawmill is SAWMILL_FRAMES frames; frame 0 is drawn here, DynamicLayer animates it
## while its workshop runs.
const CHEST_TEX := preload("res://art/structures/chest_basic.png")
const CHEST_R_TEX := preload("res://art/structures/chest_reinforced.png")
const CRATE_TEX := preload("res://art/structures/crate.png")
const SAWMILL_TEX := preload("res://art/structures/sawmill.png")
const SAWMILL_FRAMES := 4
## Stone cutter: a mason's bench, 32 px top-down (tools/tilekit/stonecutter.py, concept A).
const CUTTER_TEX := preload("res://art/structures/stonecutter.png")
const ROAD_EDGE := [0.35, 0.16]
const WALL_TILE_PX := 32.0
## Wood floor: a strip of FLOOR_VARIANTS 32 px tiles, picked per cell by a hash.
## Generated by tools/tilekit/wood_floor.py.
const WOOD_FLOOR := preload("res://art/structures/wood_floor.png")
const FLOOR_VARIANTS := 4
## Soft shadow a wall casts on the floor beside it: alpha per 1-px band, edge inward.
const WALL_SHADE := [0.43, 0.27, 0.14]

const REDRAW_SECS := 0.25
const REFRESH_SECS := 1.0

const DOOR := Color(0.70, 0.50, 0.28)
const BOARD_POST := Color(0.35, 0.22, 0.10)
const BOARD_SIGN := Color(0.80, 0.70, 0.45)
const CHEST := Color(0.55, 0.33, 0.12)
const CHEST_BAND := Color(0.25, 0.15, 0.06)
const DOOR_R := Color(0.52, 0.36, 0.20)
const METAL := Color(0.62, 0.62, 0.66)
const IRON := Color(0.22, 0.23, 0.26)
const RIVET := Color(0.62, 0.63, 0.68)
const FURNACE := Color(0.30, 0.27, 0.26)
const GLOW := Color(1.0, 0.45, 0.08)
const MAILBOX := Color(0.30, 0.42, 0.62)
const MAILBOX_FLAG := Color(0.80, 0.20, 0.15)

## Furnaces, crates and sawmills seen on the last redraw: DynamicLayer draws their live
## parts (the lit glow, the iron mark, the spinning blade) on top every frame.
var furnaces: Array[Furniture] = []
var crates: Array[Furniture] = []
var sawmills: Array[Furniture] = []

var _pieces_seen := -1
var _zones_seen := -1
var _show_zones_seen := true
var _since := INF
var _outline_version := -1
var _outline := {} # kingdom id -> PackedVector2Array of line segments


func _ready() -> void:
	texture_filter = CanvasItem.TEXTURE_FILTER_NEAREST_WITH_MIPMAPS # pixel-art wall tiles
	show_behind_parent = true


func _process(dt: float) -> void:
	_since += dt
	var show: bool = get_parent().show_zones and get_parent().debug
	World.privilege_owner(Vector2i.ZERO) # rebuild zones if dirty, so zone_version is current
	var dirty := World.pieces_version != _pieces_seen or World.zone_version != _zones_seen or show != _show_zones_seen
	if (dirty and _since >= REDRAW_SECS) or _since >= REFRESH_SECS:
		_pieces_seen = World.pieces_version
		_zones_seen = World.zone_version
		_show_zones_seen = show
		_since = 0.0
		queue_redraw()


func _draw() -> void:
	var t := Time.get_ticks_usec()
	_draw_body()
	World.prof_add("draw_pieces", t)


func _draw_body() -> void:
	var s := float(Cfg.CELL)
	if _show_zones_seen:
		for f in World.house_fires:
			if not f.burning():
				continue
			var fac: Faction = World.factions.get(f.owner_id)
			var col: Color = fac.color if fac else Color.WHITE
			var r := Cfg.PRIVILEGE_RADIUS
			var rect := Rect2(Vector2(f.cell - Vector2i(r, r)) * s, Vector2(r * 2 + 1, r * 2 + 1) * s)
			draw_rect(rect, Color(col, 0.08))
			draw_rect(rect, Color(col, 0.35), false, 1.0 * Cfg.PX)
		_draw_kingdom_outlines()
		for k in World.kingdoms.values():
			if k.has_city:
				for idx in k.plots:
					var r := Cities.plot_rect(k, idx)
					draw_rect(Rect2(Vector2(r.position) * s, Vector2(r.size) * s), Color(k.color, 0.18), false, 1.0 * Cfg.PX)
		for h in World.all_houses():
			if h.state == House.State.PLANNED or h.state == House.State.BUILDING:
				var outer := h.footprint()
				draw_rect(Rect2(Vector2(outer.position) * s, Vector2(outer.size) * s), Color(1, 1, 1, 0.25), false, 1.0 * Cfg.PX)
	for c in World.roads:
		var p := Vector2(c) * s
		var v := posmod(c.x * 73856093 ^ c.y * 19349663, ROAD_VARIANTS)
		var src := Rect2(Vector2(v * WALL_TILE_PX, 0), Vector2.ONE * WALL_TILE_PX)
		draw_texture_rect_region(ROAD_TEX[clampi(World.roads[c], 1, 2) - 1], Rect2(p, Vector2(s, s)), src)
		_edge_bands(c, s, func(n: Vector2i) -> bool: return not World.roads.has(n), ROAD_EDGE)
	for fl in World.floors.values():
		_draw_wood_floor(fl.cell, s, Color.WHITE.darkened(0.4 * (1.0 - fl.hp / fl.max_hp)))
	# Render only: building fires sit on a floor tile (the fire cell has no Floor piece).
	for f in World.house_fires:
		if f.house != null:
			_draw_wood_floor(f.cell, s, Color.WHITE)
	furnaces.clear()
	crates.clear()
	sawmills.clear()
	for fu in World.furniture.values():
		_draw_furniture(fu, Vector2(fu.cell) * s, s)
	for w in World.walls.values():
		var p := Vector2(w.cell) * s
		var col: Color
		if w.tier >= 2:
			col = IRON
		elif w.tier > 0:
			col = DOOR_R
		else:
			col = DOOR
		var wear: float = 0.5 * (1.0 - w.hp / w.max_hp)
		if not w.is_door:
			_draw_wall(w.cell, p, s, WALL_SHEETS[clampi(w.tier, 0, 2)], Color.WHITE.darkened(wear))
			continue
		col = col.darkened(wear)
		draw_rect(Rect2(p, Vector2(s, s)), col)
		if w.tier >= 2:
			# Dark iron with rivets.
			draw_rect(Rect2(p, Vector2(s, s)), RIVET.darkened(0.3), false, 1.0 * Cfg.PX)
			for r in [Vector2(0.18, 0.18), Vector2(0.82, 0.18), Vector2(0.18, 0.82), Vector2(0.82, 0.82)]:
				draw_rect(Rect2(p + r * s - Vector2.ONE * Cfg.PX, Vector2.ONE * 2.0 * Cfg.PX), RIVET)
		elif w.tier > 0:
			# Plank seams, and iron bands on doors.
			draw_line(p + Vector2(s * 0.5, 0), p + Vector2(s * 0.5, s), col.darkened(0.35), 1.0 * Cfg.PX)
			draw_rect(Rect2(p, Vector2(s, s)), METAL, false, 1.0 * Cfg.PX)
		var fac: Faction = World.factions.get(w.owner_id)
		if fac:
			draw_rect(Rect2(p + Vector2(s * 0.3, s * 0.3), Vector2(s * 0.4, s * 0.4)), fac.color)


## Wood floor tile, plus the soft shadow of any wall on its four sides.
func _draw_wood_floor(c: Vector2i, s: float, tint: Color) -> void:
	var p := Vector2(c) * s
	var v := posmod(c.x * 73856093 ^ c.y * 19349663, FLOOR_VARIANTS)
	var src := Rect2(Vector2(v * WALL_TILE_PX, 0), Vector2.ONE * WALL_TILE_PX)
	draw_texture_rect_region(WOOD_FLOOR, Rect2(p, Vector2(s, s)), src, tint)
	_edge_bands(c, s, func(n: Vector2i) -> bool: return World.walls.has(n), WALL_SHADE)


## Dark 1-px bands fading inward along each side of cell c whose neighbour passes `side`
## (alpha per band, edge first): wall shadow on floors, road edges against grass.
func _edge_bands(c: Vector2i, s: float, side: Callable, alphas: Array) -> void:
	var p := Vector2(c) * s
	var px: float = s / WALL_TILE_PX
	for d: Vector2i in [Vector2i.UP, Vector2i.RIGHT, Vector2i.DOWN, Vector2i.LEFT]:
		if not side.call(c + d):
			continue
		for i in alphas.size():
			var band: Rect2
			match d:
				Vector2i.UP: band = Rect2(p + Vector2(0, i * px), Vector2(s, px))
				Vector2i.DOWN: band = Rect2(p + Vector2(0, s - (i + 1) * px), Vector2(s, px))
				Vector2i.LEFT: band = Rect2(p + Vector2(i * px, 0), Vector2(px, s))
				_: band = Rect2(p + Vector2(s - (i + 1) * px, 0), Vector2(px, s))
			draw_rect(band, Color(0, 0, 0, alphas[i]))


## Autotiled wall from a tier's sheet: joins any wall or door on the four sides, so
## corners and T-joins line up.
func _draw_wall(c: Vector2i, p: Vector2, s: float, sheet: Texture2D, tint: Color) -> void:
	var m := 0
	if World.walls.has(c + Vector2i.UP):
		m |= 1
	if World.walls.has(c + Vector2i.RIGHT):
		m |= 2
	if World.walls.has(c + Vector2i.DOWN):
		m |= 4
	if World.walls.has(c + Vector2i.LEFT):
		m |= 8
	var src := Rect2(Vector2(m & 3, m >> 2) * WALL_TILE_PX, Vector2.ONE * WALL_TILE_PX)
	draw_texture_rect_region(sheet, Rect2(p, Vector2(s, s)), src, tint)


func _kingdom_of(fid: int) -> Kingdom:
	var f: Faction = World.factions.get(fid)
	return f.kingdom if f else null


## Outline of each kingdom's merged territory, rebuilt only when the zones change.
func _draw_kingdom_outlines() -> void:
	if _outline_version != World.zone_version:
		_outline_version = World.zone_version
		_build_outlines()
	for kid in _outline:
		var k: Kingdom = World.kingdoms.get(kid)
		if k:
			draw_multiline(_outline[kid], k.color, 2.0 * Cfg.PX)


func _build_outlines() -> void:
	_outline.clear()
	if World.kingdoms.is_empty():
		return
	var s := float(Cfg.CELL)
	var w := Cfg.MAP_W
	var kmap := PackedInt32Array()
	kmap.resize(w * Cfg.MAP_H)
	for i in kmap.size():
		var owner := World.zone_map[i]
		if owner != 0:
			var f: Faction = World.factions.get(owner)
			if f and f.kingdom:
				kmap[i] = f.kingdom.id
	for y in Cfg.MAP_H:
		for x in w:
			var k := kmap[y * w + x]
			if k == 0:
				continue
			if not _outline.has(k):
				_outline[k] = PackedVector2Array()
			var seg: PackedVector2Array = _outline[k]
			var p := Vector2(x, y) * s
			if x == 0 or kmap[y * w + x - 1] != k:
				seg.append_array([p, p + Vector2(0, s)])
			if x == w - 1 or kmap[y * w + x + 1] != k:
				seg.append_array([p + Vector2(s, 0), p + Vector2(s, s)])
			if y == 0 or kmap[(y - 1) * w + x] != k:
				seg.append_array([p, p + Vector2(s, 0)])
			if y == Cfg.MAP_H - 1 or kmap[(y + 1) * w + x] != k:
				seg.append_array([p + Vector2(0, s), p + Vector2(s, s)])
			_outline[k] = seg


func _draw_furniture(fu: Furniture, p: Vector2, s: float) -> void:
	match fu.kind:
		Furniture.Kind.CHEST:
			if fu.tier < 2:
				draw_texture_rect(CHEST_TEX if fu.tier == 0 else CHEST_R_TEX, Rect2(p, Vector2(s, s)), false)
				return
			var r := Rect2(p + Vector2(s * 0.15, s * 0.25), Vector2(s * 0.7, s * 0.55))
			draw_rect(r, CHEST)
			draw_rect(Rect2(r.position + Vector2(0, r.size.y * 0.35), Vector2(r.size.x, s * 0.1)), CHEST_BAND)
			if fu.tier >= 2:
				# Iron-bound: dark iron bands and corner rivets.
				draw_rect(r, IRON, false, 2.0 * Cfg.PX)
				draw_rect(Rect2(r.position + Vector2(r.size.x * 0.45, 0), Vector2(s * 0.1, r.size.y)), IRON)
				for c in [r.position, r.position + Vector2(r.size.x - 2.0 * Cfg.PX, 0), r.end - Vector2.ONE * 2.0 * Cfg.PX, r.position + Vector2(0, r.size.y - 2.0 * Cfg.PX)]:
					draw_rect(Rect2(c, Vector2.ONE * 2.0 * Cfg.PX), RIVET)
		Furniture.Kind.BOARD:
			draw_rect(Rect2(p + Vector2(s * 0.45, s * 0.35), Vector2(s * 0.1, s * 0.6)), BOARD_POST)
			draw_rect(Rect2(p + Vector2(s * 0.1, s * 0.05), Vector2(s * 0.8, s * 0.45)), BOARD_SIGN)
			var k := _kingdom_of(fu.owner_id)
			if k:
				draw_rect(Rect2(p + Vector2(s * 0.1, s * 0.05), Vector2(s * 0.8, s * 0.45)), k.color, false, 1.5 * Cfg.PX)
		Furniture.Kind.MAILBOX:
			# Placeholder until art exists: a post with a box and a little flag.
			draw_rect(Rect2(p + Vector2(s * 0.44, s * 0.45), Vector2(s * 0.12, s * 0.5)), BOARD_POST)
			draw_rect(Rect2(p + Vector2(s * 0.2, s * 0.15), Vector2(s * 0.6, s * 0.35)), MAILBOX)
			draw_rect(Rect2(p + Vector2(s * 0.2, s * 0.15), Vector2(s * 0.6, s * 0.35)), MAILBOX.darkened(0.5), false, 1.0 * Cfg.PX)
			draw_rect(Rect2(p + Vector2(s * 0.76, s * 0.08), Vector2(s * 0.06, s * 0.22)), MAILBOX_FLAG)
		Furniture.Kind.SAWMILL:
			sawmills.append(fu)
			draw_texture_rect_region(SAWMILL_TEX, Rect2(p, Vector2(s, s)), Rect2(0, 0, WALL_TILE_PX, WALL_TILE_PX))
		Furniture.Kind.CUTTER:
			draw_texture_rect(CUTTER_TEX, Rect2(p, Vector2(s, s)), false)
		Furniture.Kind.FURNACE:
			# Stone body; the unlit mouth here, the lit glow per frame in DynamicLayer.
			furnaces.append(fu)
			draw_rect(Rect2(p + Vector2(s * 0.08, s * 0.08), Vector2(s * 0.84, s * 0.84)), FURNACE)
			if not furnace_lit(fu):
				draw_rect(Rect2(p + Vector2(s * 0.25, s * 0.45), Vector2(s * 0.5, s * 0.35)), GLOW.darkened(0.7))
		Furniture.Kind.ANVIL:
			draw_texture_rect(ANVIL_TEX, Rect2(p, Vector2(s, s)), false)
		Furniture.Kind.CRATE:
			# The iron mark (contents change often) is drawn per frame in DynamicLayer.
			crates.append(fu)
			draw_texture_rect(CRATE_TEX, Rect2(p, Vector2(s, s)), false)


static func furnace_lit(fu: Furniture) -> bool:
	return fu.house != null and fu.house.fire != null and fu.house.fire.burning()
